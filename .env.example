# Copy this file to `.env` and fill in your Supabase project credentials.
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# Both values live in Supabase Dashboard -> Project Settings -> API.
# The anon key is a public client key, but keep the service_role key OUT of this file.
#
# Leaving these blank is fine: the app boots in DEMO MODE with local mock data
# so you can run `npm run dev` before the backend exists.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
