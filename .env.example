# Copy this file to `.env` and fill in your Supabase project credentials.
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# Both values live in Supabase Dashboard -> Project Settings -> API.
# The anon key is a public client key, but keep the service_role key OUT of this file.
#
# Leaving these blank is fine: the app uses local mock data and the Production
# option on the login page stays unavailable until both values are configured.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dashboard login defaults to dummy mode. Set this to `true` to default to
# Supabase mode; the selected dashboard mode can also be changed at login.
VITE_DASHBOARD_USE_SUPABASE=false
